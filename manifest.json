{
  "manifest_version": 2,
  "name": "TinkeDin - LinkedIn Feed Control",
  "version": "0.5.0",
  "description": "Take control of your LinkedIn feed - Tinder-style swipe interface",
  "browser_specific_settings": {
    "gecko": {
      "id": "tinkedin@asimon.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "permissions": [
    "storage",
    "*://*.linkedin.com/*",
    "*://0.peerjs.com/*"
  ],
  "background": {
    "scripts": ["lib/peerjs.min.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["styles/tinkedin.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.svg"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-48.svg"
  }
}
